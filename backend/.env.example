# ==============================================================================
# ACAD SUPERVISORY CONTROL PLANE - BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# Node Runtime & Server
NODE_ENV=production
PORT=8002
HOST=0.0.0.0

# CORS Origin (URL of the Vercel-hosted Control Frontend)
CORS_ORIGIN=https://acad-control.vercel.app

# Database Configuration (Render PostgreSQL or Neon / Supabase)
# If left empty, will fall back to local isolated SQLite (acad_control.db) in development
DATABASE_URL=postgresql://acad_control_user:password@dpg-xxxx.render.com/acad_control_db

# Security & Master JWT Secret (Generate with: openssl rand -hex 64)
CONTROL_JWT_SECRET=your-secure-control-plane-jwt-secret-at-least-64-characters-long

# Initial Platform Owner Account Credentials (Provisioned on first seed)
CONTROL_ADMIN_EMAIL=superadmin@acad.education
CONTROL_ADMIN_PASSWORD=change-me-to-a-secure-master-password-before-deploying
